// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Produto {
  id          String       @id @default(cuid())
  nome        String
  slug        String       @unique
  descricao   String
  preco       Float
  precoPromo  Float?
  imagens      String[]
  imagensPorCor Json?   // { "Amarelo": ["url1", "url2"], "Verde": ["url3"] }
  video        String?
  ativo       Boolean      @default(true)
  destaque    Boolean      @default(false)
  colecoes    String[] // "copa-2026" | "canelado" | "basics"
  material    String?
  variacoes    Variacao[]
  ordem        Int          @default(0)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  itens        ItemPedido[]
  reviews      Review[]
}

model Review {
  id         String   @id @default(cuid())
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId  String
  nome       String
  email      String
  nota       Int      // 1 a 5
  titulo     String?
  comentario String
  aprovado   Boolean  @default(false)
  criadoEm  DateTime @default(now())
}

model Variacao {
  id        String  @id @default(cuid())
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId String
  cor       String
  tamanho   String // PP | P | M | G | GG
  estoque   Int     @default(0)
}

model Pedido {
  id          String       @id @default(cuid())
  numero      String       @unique
  status      String       @default("pendente")
  // pendente | pago | enviado | entregue | cancelado
  total       Float
  desconto    Float        @default(0)
  cupomUsado  String?
  mpPaymentId String?
  mpStatus    String?
  pixQrCode    String?
  pixCopiaCola String?
  rastreio     String?
  freteValor   Float?
  freteServico String?
  fretePrazo   Int?
  cliente     Cliente?     @relation(fields: [clienteId], references: [id])
  clienteId   String?
  nomeCliente String
  emailCliente String
  telefone    String?
  cpf         String?
  endereco    Json
  itens       ItemPedido[]
  criadoEm    DateTime     @default(now())
  atualizadoEm DateTime   @updatedAt
}

model ItemPedido {
  id        String  @id @default(cuid())
  pedido    Pedido  @relation(fields: [pedidoId], references: [id])
  pedidoId  String
  produto   Produto @relation(fields: [produtoId], references: [id])
  produtoId String
  cor       String
  tamanho   String
  quantidade Int
  precoUnit Float
}

model Cliente {
  id       String   @id @default(cuid())
  nome     String
  email    String   @unique
  telefone String?
  cpf      String?
  pedidos  Pedido[]
  criadoEm DateTime @default(now())
}

model Cupom {
  id         String    @id @default(cuid())
  codigo     String    @unique
  tipo       String // "percentual" | "fixo"
  valor      Float
  minPedido  Float?
  maxUsos    Int?
  usosAtuais Int       @default(0)
  ativo      Boolean   @default(true)
  expiraEm   DateTime?
  criadoEm   DateTime  @default(now())
}

model Colecao {
  id        String  @id @default(cuid())
  nome      String
  slug      String  @unique
  subtitulo String
  imagem    String?
  href      String
  ordem     Int     @default(0)
  ativo     Boolean @default(true)
}

model Aparencia {
  id String @id @default("aparencia")

  // Logotipo
  logoTexto        String?
  logoUrl          String?

  // Banner anúncio (barra topo)
  bannerAtivo      Boolean @default(true)
  bannerTexto      String?
  bannerLink       String?
  bannerLinkTexto  String?

  // Home — Hero principal
  homeHeroImagem     String?
  homeHeroTitulo     String?
  homeHeroSubtitulo  String?
  homeHeroBotaoTexto String?
  homeHeroBotaoLink  String?

  // Home — Seção "Nossa História"
  sobreTitulo    String?
  sobreDescricao String?
  sobreImagem    String?
  sobreBotaoTexto String?

  // Copa 2026 — Hero
  copaHeroImagem    String?
  copaHeroTitulo    String?
  copaHeroSubtitulo String?

  // Catálogo — Banner topo
  catalogoTitulo         String?
  catalogoBannerImagem   String?

  // Página Produto
  produtoSecaoTitulo String?

  // Checkout
  checkoutTitulo String?

  // Rodapé
  rodapeDescricao String?

  // Cores principais (hex)
  corVerdePrincipal String?
  corOuro           String?
  corFundo          String?
  corCreme          String?
}

model Configuracao {
  id             String  @id @default("config")
  tikTokPixelId  String?
  metaPixelId    String?
  whatsappNumero String?
  instagramUrl   String?
  tiktokUrl      String?
  facebookUrl    String?
  crmApiKey      String?
  crmTipo           String? // "rdstation" | "hubspot"
  emailRemetente    String?
  googleAnalyticsId String?
  googleAdsId       String?
}
